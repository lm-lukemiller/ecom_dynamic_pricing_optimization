{
  "name": "Pricing dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {"label": "Pricing dashboard", "onAutoForward": "openBrowser"},
    "8000": {"onAutoForward": "ignore"}
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "python .devcontainer/start.py"
}
